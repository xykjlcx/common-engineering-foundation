{
  "name": "@keel/core",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "pnpm client:check && rm -rf dist && tsc -p tsconfig.build.json",
    "start:prod": "NODE_ENV=production node dist/index.js",
    "typecheck": "tsc --noEmit && pnpm client:check",
    "lint": "eslint src scripts",
    "db:migrate": "tsx scripts/migrate.ts",
    "maintenance": "tsx scripts/maintenance.ts",
    "db:generate": "drizzle-kit generate",
    "openapi:generate": "tsx scripts/generate-openapi.ts",
    "seed:admin": "tsx scripts/seed-admin.ts",
    "seed:permissions": "tsx scripts/seed-permissions.ts",
    "client:generate": "node scripts/generate-client.mjs",
    "client:check": "node scripts/generate-client.mjs --check && node scripts/check-client-boundary.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@hono/node-server": "^1.14.0",
    "@node-rs/argon2": "^2.2.0",
    "@orpc/client": "1.14.8",
    "@orpc/openapi": "1.14.8",
    "@orpc/server": "1.14.8",
    "@orpc/zod": "1.14.8",
    "cron-parser": "5.10.1",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.8.0",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.2",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.6.0",
    "globals": "^17.7.0",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.19.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.62.1",
    "vitest": "^4.1.9"
  },
  "exports": {
    "./router": {
      "browser": null,
      "node": "./src/router.ts"
    },
    "./openapi": {
      "browser": null,
      "node": "./src/openapi.ts"
    },
    "./errors": {
      "browser": null,
      "node": "./src/errors.ts"
    },
    "./permission-wiring": {
      "browser": null,
      "node": "./src/modules/menu/domain/permission-wiring.ts"
    },
    "./kernel/*": {
      "browser": null,
      "node": "./src/kernel/*.ts"
    },
    "./user-contract": "./src/modules/user/contract.ts",
    "./user-batch-contract": "./src/modules/user/batch-contract.ts",
    "./user-import-contract": "./src/modules/user/import-contract.ts",
    "./role-contract": "./src/modules/role/contract.ts",
    "./dept-contract": "./src/modules/dept/contract.ts",
    "./profile-contract": "./src/modules/profile/contract.ts",
    "./query-scheme-contract": "./src/modules/query-scheme/contract.ts",
    "./user-filter-contract": "./src/modules/user/filter-contract.ts",
    "./client": {
      "types": "./client/index.d.ts"
    },
    "./auth-contract": "./src/modules/auth/contract.ts",
    "./menu-contract": "./src/modules/menu/contract.ts",
    "./dict-contract": "./src/modules/dict/contract.ts",
    "./post-contract": "./src/modules/post/contract.ts",
    "./audit-contract": "./src/modules/audit/contract.ts",
    "./dashboard-contract": "./src/modules/dashboard/contract.ts",
    "./job-contract": "./src/modules/job/contract.ts",
    "./message-contract": "./src/modules/message/contract.ts",
    "./notice-contract": "./src/modules/notice/contract.ts",
    "./settings-contract": "./src/modules/settings/contract.ts"
  }
}
