# @keel/core 环境变量总表。复制为 .env 后按环境填写；.env* 不提交。
# 每项标注「生产 fail-closed 含义」= 该项缺失或写错时，生产会拒绝启动还是静默降级。

# ── 运行环境 ────────────────────────────────────────────────────────────────
# development | test | production。production 会打开 Secure Cookie、关闭 PGlite 自动迁移，
# 并要求下面几项显式配置（缺失即拒绝启动，不猜默认值）。
NODE_ENV=development

# HTTP 监听端口。默认 3100。
PORT=3100

# 日志级别：fatal|error|warn|info|debug|trace|silent。默认 info。
LOG_LEVEL=info

# ── 数据库 ──────────────────────────────────────────────────────────────────
# postgres | pglite。默认 postgres。
# 生产 fail-closed：production + pglite 不会自动迁移，启动时逐条校验迁移历史，对不上即拒绝启动。
DATABASE_DRIVER=postgres

# postgres 驱动的连接串。fail-closed：DATABASE_DRIVER=postgres 而此项缺失时 loadEnv 直接抛错。
DATABASE_URL=

# PGlite 数据目录。留空表示 memory://（进程内，退出即失），仅适合本地开发与测试。
PGLITE_DATA_DIR=

# core 连接池上限。默认 10。预算口径：core 池 + 任务池 + 运维预留 ≤ max_connections 的 80%。
DB_POOL_MAX=10

# ── 网络与来源 ──────────────────────────────────────────────────────────────
# 允许跨域的 Origin 白名单，逗号分隔。
# 生产 fail-closed：production 下留空 = 不放行任何跨域，且 CSRF 同源校验保持开启；
# 非生产留空则反射任意 Origin 并短路 CSRF 闸（仅开发便利，不可用于预发/生产）。
CORS_ORIGINS=

# 可信反代跳数（0-8）。默认 0 = 不信任 X-Forwarded-For，客户端 IP 取 socket 地址。
# 必须与实际代理层数一致：配大了等于让调用方自选 IP，失败锁定与审计的 IP 维度就此失真。
TRUSTED_PROXY_HOPS=0

# ── 文件存储 ────────────────────────────────────────────────────────────────
# 头像等对象的本地卷目录。
# 生产 fail-closed：production 未配置时 loadEnv 抛错；test 下也必须显式指定临时目录。
FILE_STORAGE_DIR=

# ── 登录失败锁定与会话时长 ──────────────────────────────────────────────────
# 以下五项缺省即当前实现值，改动等于改安全策略；调小会放宽爆破窗口，不会有额外告警。
# 单账号在窗口内的失败上限，达到即锁定。默认 5。
LOGIN_LOCK_THRESHOLD=5
# 单 IP 在窗口内的失败上限（软限制，避免共享 NAT 出口阻断合法账号）。默认 20。
LOGIN_IP_THRESHOLD=20
# 失败计数窗口，毫秒。默认 900000（15 分钟）。
LOGIN_LOCK_WINDOW_MS=900000
# 普通会话有效期，毫秒。默认 43200000（12 小时）。
SESSION_TTL_MS=43200000
# 记住我会话有效期，毫秒。默认 604800000（7 天）；不可越过会话绝对过期上限（30 天）。
SESSION_REMEMBER_TTL_MS=604800000

# ── 初始化与运维脚本（不参与 loadEnv，只被对应脚本读取）────────────────────
# seed:admin 的初始管理员账号与口令。
# 生产 fail-closed：production 下必须显式给出用户名与非演示口令（≥8 位且不等于 admin123），否则脚本拒绝执行。
SEED_ADMIN_USERNAME=
SEED_ADMIN_PASSWORD=

# 真实 PostgreSQL 测试的控制库连接串（DATABASE_DRIVER=postgres 跑测试时必填）。
# fail-closed：库名必须含独立的 test 段，且绝不回退到业务 DATABASE_URL；测试角色需要 CREATEDB。
TEST_DATABASE_URL=

# seed:permissions 读取的权限目录产物目录。留空取仓内默认 apps/web/scripts/permissions/generated。
PERMISSION_CATALOG_DIR=
