# apps/web 环境变量样例。复制成 .env.development / .env.production / .env.demo 后按需覆盖
# （`.env*` 已被 .gitignore 忽略，只有本样例文件跟踪）。语义定义见 src/config/env.ts。

# 应用环境标签：local / development / test / staging / production / demo；缺省按 Vite mode 推导
VITE_APP_ENV=
# 显示用版本号，缺省 0.1.0
VITE_APP_VERSION=
# REST/RPC 基址前缀；缺省空串（同源，经 vite 代理或同域网关）
VITE_API_BASE_URL=
# 默认语言：zh-CN / en-US，缺省 zh-CN
VITE_DEFAULT_LOCALE=
# 请求超时毫秒，正整数，缺省 15000；写请求超时按「结果未知」处理，不自动重放
VITE_REQUEST_TIMEOUT_MS=
# mock worker 开关：demo 模式恒开；开发态默认关，显式 true 才开；生产构建恒关（构建期与 CI 双重剥离）
VITE_ENABLE_MOCK=false
# TanStack devtools 开关，缺省跟随开发态
VITE_ENABLE_DEVTOOLS=
# 视觉调试标记，缺省 false
VITE_ENABLE_VISUAL_DEBUG=
# 仅开发服务器读取（vite.config.ts，不进浏览器包）：/api 与 /rpc 代理指向的后端源，缺省 http://127.0.0.1:3100
VITE_CORE_ORIGIN=
